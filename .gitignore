# --- secrets -------------------------------------------------------------
# Real configuration never goes in. The .example files DO -- see below.
.env
.env.local
.env.production
# Every variant, not three named ones. A backup taken before a change --
# .env.local.before-tunnel -- holds the same live keys as the file it
# copied, and a throwaway .env.buildtest still reads as real configuration
# to whoever clones this next. The .example negations below still win.
.env.*
*.key
*.pem
credentials.json
token.json
client_secret*.json
gmail_token.json

# The example files are documentation and must be published. Without this
# negation, a broad `.env.*` rule swallows them and a fresh clone has no
# record of which settings exist.
!.env.example
!.env.docker.example
!**/.env.example

# --- personal data -------------------------------------------------------
# This project's whole subject matter is CVs. None belong in the repository.
*.pdf
*.docx
master_cv.yaml

# --- local databases -----------------------------------------------------
# PGlite's development database, and the recovery copies made when one is
# corrupted. Both contain real user rows.
.pglite*
*.db
*.db.bak*

# --- build output --------------------------------------------------------
node_modules/
.next/
out/
__pycache__/
*.pyc
.venv/
tsconfig.tsbuildinfo

# NOTE: package-lock.json is deliberately NOT ignored. `npm ci` in the
# Dockerfile requires it, and without it committed the image cannot build
# from a fresh clone -- and nobody gets the dependency versions this was
# actually tested against.

# --- logs and editors ----------------------------------------------------
*.log
.vscode/
.idea/
.DS_Store

# The LinkedIn browser session created by job_scout.linkedin_login. It is a
# logged-in session; it belongs on one machine and nowhere near a repository.
.pw-profile/
# And any copy of it. Setting one aside before signing in as somebody else
# leaves .pw-profile.real-account-<date>/ next to it, holding the same live
# session cookies -- committing that publishes a working LinkedIn login.
.pw-profile*
