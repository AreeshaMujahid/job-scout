# Copy to .env next to docker-compose.yml. Do not commit the result.
#
#   cp .env.docker.example .env
#
# Compose refuses to start if any of the required ones below are missing,
# rather than booting a half-configured stack that looks healthy.

# --- required -------------------------------------------------------------

# Where people reach the app. Used to build magic-link sign-in URLs, so it
# must be the address they can actually click -- not localhost, in production.
APP_URL=https://jobs.example.com

POSTGRES_PASSWORD=          # openssl rand -base64 24
SCOUT_TOKEN=                # openssl rand -base64 24

# Encrypts stored OAuth refresh tokens. Changing it makes every connected
# Gmail account unreadable -- they would each have to reconnect. Back it up
# with the database, and treat losing it as losing those grants.
ENCRYPTION_KEY=             # openssl rand -base64 48

# --- the model ------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- sign-in mail ---------------------------------------------------------
# REQUIRED for signup to work at all. New accounts must confirm their address
# before their password is accepted, and that confirmation arrives by email --
# so with no SMTP here, nobody can create an account in production. The
# print-to-terminal fallback that makes local development easy is disabled
# in production on purpose.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Job Scout <hello@example.com>"

# --- inbox tracking -------------------------------------------------------

# The domain forwarded application mail is accepted on. Point its MX records
# at your inbound provider (Postmark, SendGrid, Mailgun, Cloudflare Email
# Workers) and have it POST to https://<APP_URL>/api/inbound.
# Use a subdomain, not your main one -- its MX records belong to the inbound
# provider, and pointing your whole domain at them would divert your own mail.
INBOUND_DOMAIN=inbox.example.com

# Shared with the inbound provider, sent as an X-Inbound-Secret header or a
# ?secret= query parameter. Unset means every inbound message is refused --
# an open endpoint would let anyone write into any user's tracker.
INBOUND_SECRET=             # openssl rand -base64 32

# false (default): every detected change waits for the user to confirm.
# true: high-confidence, forward-only changes move the tracker on their own.
# A rejection is never applied automatically either way, and everything that
# is applied stays undoable.
INBOX_AUTO_APPLY=false

# How long a received message is kept after it has been classified. The
# decision it produced, and the one sentence quoted in it, outlive this.
INBOX_RETENTION_DAYS=30

# How often the worker looks for new mail, in seconds.
WORKER_INTERVAL_SECONDS=900

# --- Gmail connector (off until Google has reviewed your OAuth app) -------
# gmail.readonly is a "restricted" scope: publishing it needs OAuth
# verification plus an annual third-party CASA security assessment. Until
# that clears, the consent screen only admits test users you add by hand --
# so leave this false and let everyone use forwarding.
GMAIL_CONNECTOR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- admin panel ----------------------------------------------------------
# Who may open /admin, comma-separated. Matched against the signed-in user's
# CONFIRMED email address. Leave it unset and nobody can -- which is the right
# default: an admin panel that opens itself is one deploy away from public.
# The panel can read a CV and delete an account; every action it takes is
# written to admin_actions with the address that took it.
ADMIN_EMAILS=

# --- optional -------------------------------------------------------------
WEB_PORT=3000
POSTGRES_USER=jobscout
POSTGRES_DB=jobscout
