# Copy to .env.local for development, or set these in your host's dashboard.

# Where this app is reachable. Used to build the magic-link URL, so it must be
# the address people actually click. Falls back to the request's own host.
APP_URL=http://localhost:3000

# The Python rating service (job_scout/service.py).
SCOUT_URL=http://127.0.0.1:8000
# Must match SCOUT_TOKEN in the service's environment. Leave both unset
# locally; set both to the same random string anywhere the service is
# reachable from outside the app.
SCOUT_TOKEN=

# --- database -------------------------------------------------------------
# Unset: an embedded Postgres (PGlite) is created in ./.pglite. Zero setup,
# perfect for one machine, gone if you delete the folder.
# Set: any Postgres. This is the deployed path.
# DATABASE_URL=postgres://user:password@host:5432/jobscout
# DATABASE_SSL=false          # only for a local Postgres with no TLS

# --- email ----------------------------------------------------------------
# With no SMTP host, every link this app sends -- sign-in, confirmation and
# password reset -- is printed to the dev server's terminal and shown on
# screen. That fallback is disabled in production: deploy without these and
# nobody can sign in, and nobody can create an account either, because a new
# account has to confirm its address before its password is accepted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Job Scout <you@example.com>"
