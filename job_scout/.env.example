# Copy to job_scout/.env and fill in. If a value is missing here, the repo-root
# .env is read as a fallback, so an existing key does not need copying.

# --- which model rates the jobs ------------------------------------------
# gemini (default) or anthropic.
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Only read when LLM_PROVIDER=anthropic. https://console.anthropic.com
# ANTHROPIC_API_KEY=
# JOB_SCOUT_MODEL=claude-opus-5
