# Copy to job_scout/.env and fill in. If a value is missing here, the repo-root
# .env is read as a fallback, so an existing key does not need copying.

# --- which model rates the jobs ------------------------------------------
# gemini (default) or anthropic.
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Only read when LLM_PROVIDER=anthropic. https://console.anthropic.com
# ANTHROPIC_API_KEY=
# JOB_SCOUT_MODEL=claude-opus-5

# --- extra job boards (all optional) --------------------------------------
# Each is absent rather than broken without its key: no key, no postings from
# that source, and the rest of the search is unaffected.

# Adzuna aggregates the German market under licence and searches server-side,
# so most of what it returns is on topic. https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=de

# Jooble aggregates across boards, including listings that also appear on
# Indeed -- which cannot be read directly, as every route answers 403 behind
# a bot challenge. https://jooble.org/api/about
JOOBLE_API_KEY=
# JOOBLE_LOCATION=Deutschland

# --- Indeed (opt-in, local machine only) ----------------------------------
# Off by default because it OPENS A VISIBLE BROWSER WINDOW while it searches.
# That is not cosmetic: Indeed answers 403 to server-side requests and to a
# headless browser, and 200 to a normal visible one. Nothing is spoofed --
# the only difference is whether a real window is on screen.
#
# Consequences: it cannot run on a server or in Docker, and it reads one page
# per title (~15 postings), because Indeed's robots.txt disallows the
# `&start=` URLs their pagination uses.
INDEED_ENABLED=false
# INDEED_DOMAIN=de.indeed.com
# INDEED_LOCATION=Deutschland
